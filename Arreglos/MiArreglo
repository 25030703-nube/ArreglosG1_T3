using System;

namespace Arreglos.logica
{
    public class MiArreglo
    {
        private int[] _arreglo;
        private int _tope;

        public MiArreglo(int n)
        {
            _arreglo = new int[n];
            _tope = 0;
        }

        public int N
        {
            get { return _arreglo.Length; }
        }

        public bool EstaLleno
        {
            get { return _tope == N; }
        }

        public bool EstaVacio
        {
            get { return _tope == 0; }
        }

        public void Llenar(int minimo, int maximo)
        {
            Random random = new Random();

            while (!EstaLleno)
            {
                _arreglo[_tope] = random.Next(minimo, maximo + 1);
                _tope++;
            }
        }

        public void ordenar()
        {
            Ordenar(true);
        }

        public void Ordenar(bool ascendente)
        {
            for (int i = 0; i < _tope - 1; i++)
            {
                for (int j = 0; j < _tope - 1 - i; j++)
                {
                    if (ascendente)
                    {
                        if (_arreglo[j] > _arreglo[j + 1])
                        {
                            cambiar(ref _arreglo[j], ref _arreglo[j + 1]);
                        }
                    }
                    else
                    {
                        if (_arreglo[j] < _arreglo[j + 1])
                        {
                            cambiar(ref _arreglo[j], ref _arreglo[j + 1]);
                        }
                    }
                }
            }
        }

        public void cambiar(ref int a, ref int b)
        {
            int aux = a;
            a = b;
            b = aux;
        }

        public bool Agregar(int valor)
        {
            if (EstaLleno)
            {
                return false;
            }

            _arreglo[_tope] = valor;
            _tope++;

            return true;
        }
    }
}